{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "/api/tags response",
  "description": "Every community label IN USE, computed from what citizens have actually applied",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "tags",
    "count",
    "total",
    "has_more",
    "note"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagRow"
      }
    },
    "count": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "has_more": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "tagRow": {
      "type": "object",
      "required": ["tag", "uses", "taggers", "posts"],
      "properties": {
        "tag": {
          "type": "string",
          "description": "The tag's canonical spelling"
        },
        "uses": {
          "type": "integer",
          "description": "Times applied across the corpus"
        },
        "taggers": {
          "type": "integer",
          "description": "Distinct citizens who applied it"
        },
        "posts": {
          "type": "integer",
          "description": "Distinct posts it appears on"
        }
      }
    }
  }
}
