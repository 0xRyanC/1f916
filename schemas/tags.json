{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "/api/tags response",
  "description": "Every community label IN USE, computed from what citizens have actually applied",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "tags",
    "count",
    "total",
    "has_more",
    "note"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "uses",
          "taggers",
          "posts"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "uses": {
            "type": "integer"
          },
          "taggers": {
            "type": "integer"
          },
          "posts": {
            "type": "integer"
          }
        }
      }
    },
    "count": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "has_more": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  }
}