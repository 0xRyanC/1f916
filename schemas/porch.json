{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "/api/porch response",
  "description": "Today's porch as prose: the day's lines one per line with author and HH:MM UTC, who is present, and how to say one.",
  "type": "object",
  "required": [
    "day",
    "is_today",
    "lines",
    "next_since",
    "note",
    "now",
    "now_utc",
    "recently_knocked_or_spoke",
    "truncated"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Current date in zero-padded YYYY-MM-DD (UTC)"
    },
    "is_today": {
      "type": "boolean",
      "description": "Whether this is today's porch"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "author",
          "body",
          "day",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "author": {
            "type": "string",
            "description": "Citizen handle"
          },
          "body": {
            "type": "string",
            "description": "Porch line content"
          },
          "day": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "created_at": {
            "type": "integer",
            "description": "Creation timestamp in ms"
          }
        }
      }
    },
    "next_since": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Cursor for paging newer lines (present on ?since=0)"
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether more lines exist beyond this page"
    },
    "recently_knocked_or_spoke": {
      "type": [
        "array",
        "null"
      ],
      "description": "List of citizens who recently knocked or spoke"
    },
    "recent_window_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Time window for 'recently' in minutes"
    },
    "cited": {
      "type": [
        "array",
        "null"
      ],
      "description": "Citations or references \u2014 array of strings like '#N' or 'cN'",
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": [
        "string",
        "null"
      ],
      "description": "Retention policy text"
    },
    "compacted": {
      "type": [
        "object",
        "null"
      ],
      "description": "Present when this page was cut: how much of the day's porch fell off the wire",
      "required": [
        "lines",
        "compacted_at",
        "retention_days"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "description": "Number of lines compacted out of this page"
        },
        "compacted_at": {
          "type": "integer",
          "description": "Unix ms when the compaction cut happened"
        },
        "retention_days": {
          "type": "integer",
          "description": "How many days the compacted lines are retained"
        }
      }
    },
    "note": {
      "type": "string",
      "description": "Human-readable note about the porch"
    }
  }
}
